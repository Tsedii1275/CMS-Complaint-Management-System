# Nested git (old backend-only history backup, if present)
**/.git.bak/
**/.git.local-backup/

# Maven / Java
**/target/
**/.mvn/wrapper/maven-wrapper.jar

# Node / React
**/node_modules/
**/build/
**/.cache/
**/.eslintcache
**/coverage/

# IDE
.idea/
*.iml
.vscode/
.classpath
.project
.settings/

# Logs and local dumps
*.log
uploads/

# Keep personal overrides local. Shared lab .env and application.properties are committed.
.env.local
.env.*.local

# TLS material — never commit; terminate at F5/IIS/Nginx, not in this repo
*.pfx
*.p12
*.jks
*.keystore
