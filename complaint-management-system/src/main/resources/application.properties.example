spring.application.name=complaint-management-system
# Values live in .env / .env.dev / .env.prod (dotenv files have no .properties
# suffix, so [.properties] tells Spring how to parse them).
spring.config.import=optional:file:.env[.properties],optional:file:.env.${APP_ENV:dev}[.properties]

# MySQL. sslMode=REQUIRED when the server has require_secure_transport=ON.
# Production: MYSQL_SSL_MODE=REQUIRED or VERIFY_IDENTITY.
# Optional trust store (REQUIRED/VERIFY_*): MYSQL_SSL_TRUSTSTORE_URL, MYSQL_SSL_TRUSTSTORE_PASSWORD
spring.datasource.url=jdbc:mysql://${MYSQL_HOST:localhost}:${MYSQL_PORT:3306}/${MYSQL_DATABASE:cms_db}?sslMode=${MYSQL_SSL_MODE:REQUIRED}&serverTimezone=UTC&allowPublicKeyRetrieval=${MYSQL_ALLOW_PUBLIC_KEY_RETRIEVAL:true}
spring.datasource.username=${SPRING_DATASOURCE_USERNAME}
spring.datasource.password=${SPRING_DATASOURCE_PASSWORD}
spring.datasource.driverClassName=com.mysql.cj.jdbc.Driver

spring.jpa.hibernate.ddl-auto=none
spring.jpa.show-sql=true

# Flyway Database Migration Configuration
spring.flyway.enabled=true
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=1.0
spring.flyway.out-of-order=true
spring.flyway.locations=classpath:db/migration

spring.flowable.database-schema-update=true
flowable.database-schema-update=true
flowable.check-process-definitions=true

# Customer notifications — see application.properties for the full NOTIFICATION_* list.
notification.enabled=${NOTIFICATION_ENABLED:true}
notification.email.enabled=${NOTIFICATION_EMAIL_ENABLED:true}
notification.email.provider=${NOTIFICATION_EMAIL_PROVIDER:log}
notification.email.from=${NOTIFICATION_EMAIL_FROM:}
notification.email.from-name=${NOTIFICATION_EMAIL_FROM_NAME:Customer Service Team}
notification.sms.enabled=${NOTIFICATION_SMS_ENABLED:true}
notification.sms.provider=${NOTIFICATION_SMS_PROVIDER:log}
notification.sms.default-country-code=${NOTIFICATION_SMS_DEFAULT_COUNTRY_CODE:251}

# SMTP relay / Exchange submission — set via .env.dev / .env.prod (secrets in .env.*.local)
# UAT LAN: SPRING_MAIL_HOST=192.168.0.145  SPRING_MAIL_HOST_BACKUP=192.168.0.146  SPRING_MAIL_PORT=587
spring.mail.host=${SPRING_MAIL_HOST:}
spring.mail.port=${SPRING_MAIL_PORT:587}
spring.mail.username=${SPRING_MAIL_USERNAME:}
spring.mail.password=${SPRING_MAIL_PASSWORD:}
spring.mail.properties.mail.smtp.auth=${SPRING_MAIL_SMTP_AUTH:true}
spring.mail.properties.mail.smtp.starttls.enable=${SPRING_MAIL_SMTP_STARTTLS_ENABLE:true}
spring.mail.properties.mail.smtp.starttls.required=${SPRING_MAIL_SMTP_STARTTLS_REQUIRED:true}
spring.mail.properties.mail.smtp.ssl.enable=${SPRING_MAIL_SMTP_SSL_ENABLE:false}
spring.mail.properties.mail.smtp.ssl.checkserveridentity=true
spring.mail.properties.mail.smtp.connectiontimeout=${SPRING_MAIL_CONNECTION_TIMEOUT_MS:5000}
spring.mail.properties.mail.smtp.timeout=${SPRING_MAIL_READ_TIMEOUT_MS:10000}
spring.mail.properties.mail.smtp.writetimeout=${SPRING_MAIL_WRITE_TIMEOUT_MS:10000}

# File Upload configuration
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=12MB

# Bootstrap admin — set INITIAL_ADMIN_PASSWORD in the environment (no default)
app.admin.initial-password=${INITIAL_ADMIN_PASSWORD}

# JWT — set APP_JWT_SECRET in the environment (min 32 bytes, no default)
app.jwtSecret=${APP_JWT_SECRET}
app.jwtExpirationMs=${APP_JWT_EXPIRATION_MS:900000}

# Browser-facing origin for email/SMS (React). Not a Spring SSL setting.
# Values come from .env.dev or .env.prod (APP_ENV in .env)
app.public-base-url=${APP_PUBLIC_BASE_URL:http://localhost:3000}
app.cors.allowed-origins=${APP_CORS_ALLOWED_ORIGINS:http://localhost:3000,http://127.0.0.1:3000}
server.forward-headers-strategy=framework
