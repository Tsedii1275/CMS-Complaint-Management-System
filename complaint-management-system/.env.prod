# UAT
# Frontend: dbtccvmsfrontenduat  172.22.10.17
# Backend:  dbtccvmsbackenduat   172.22.10.4
#
# Do not put MYSQL_* / SPRING_DATASOURCE_PASSWORD in this file (Sonar S6697).
# Keep the existing UAT MySQL password unchanged in gitignored .env.prod.local:
#   MYSQL_ROOT_PASSWORD=...
#   MYSQL_PASSWORD=...
#   SPRING_DATASOURCE_PASSWORD=...
# Do not rotate the live database password.

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=cms_db
MYSQL_USER=cms_user
MYSQL_PASSWORD=
SPRING_DATASOURCE_USERNAME=cms_user
SPRING_DATASOURCE_PASSWORD=

MYSQL_SSL_MODE=DISABLED
MYSQL_ALLOW_PUBLIC_KEY_RETRIEVAL=true

APP_JWT_SECRET=inLpFYxWLUZNyZgTnWxwkdKzG0mvNpZUr3hE2nzWhBxjWWBKWZqcqVx5ISUQBt0w
APP_JWT_EXPIRATION_MS=900000
JWT_ISSUER=dashenbank-cms
MFA_READY=true
LOCKOUT_THRESHOLD=6
LOCKOUT_DURATION_MINUTES=30
INITIAL_ADMIN_PASSWORD=Admin@Dashen2026!

# Bank internal SMTP relay (no username/password).
# Mail team: local IPs 192.168.0.145 / 192.168.0.146 are the intended hosts when
# UAT can route to them. From dbtccvmsbackenduat those ports time out.
# NAT IPs 10.40.30.112 / 10.40.30.113 are reachable (telnet 25 → ESMTP 220).
# Use NAT until network opens the local IPs; then switch HOST back to 192.168.0.145.
SPRING_MAIL_HOST=10.40.30.112
SPRING_MAIL_HOST_BACKUP=10.40.30.113
SPRING_MAIL_PORT=25
SPRING_MAIL_SMTP_AUTH=false
SPRING_MAIL_SMTP_STARTTLS_ENABLE=false
SPRING_MAIL_SMTP_STARTTLS_REQUIRED=false
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Customer notifications (see application.properties for every NOTIFICATION_* key).
# From address approved by mail team for this relay.
# Secrets for a future SMS gateway go in gitignored .env.prod.local, not here:
#   NOTIFICATION_SMS_GATEWAY_API_KEY / NOTIFICATION_SMS_GATEWAY_PASSWORD
NOTIFICATION_ENABLED=true
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_EMAIL_PROVIDER=smtp
NOTIFICATION_EMAIL_FROM=info@dashenbanksc.com
NOTIFICATION_EMAIL_FROM_NAME=Customer Service Team
NOTIFICATION_EMAIL_REPLY_TO=info@dashenbanksc.com

# Optional Gmail SMTP for @gmail.com recipients (Exchange rejected Gmail RCPT).
# Leave ENABLED=false until an app password is in gitignored .env.prod.local:
#   GMAIL_SMTP_USERNAME=...
#   GMAIL_SMTP_PASSWORD=...   (Google App Password, not the Gmail login)
#   GMAIL_SMTP_FROM=...       (must be that Gmail account)
GMAIL_SMTP_ENABLED=true
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_USERNAME=
GMAIL_SMTP_PASSWORD=
GMAIL_SMTP_FROM=
NOTIFICATION_SMS_ENABLED=true
NOTIFICATION_SMS_PROVIDER=log
NOTIFICATION_SMS_SENDER_ID=
NOTIFICATION_SMS_DEFAULT_COUNTRY_CODE=251
NOTIFICATION_SMS_GATEWAY_BASE_URL=
NOTIFICATION_RETRY_MAX_ATTEMPTS=5

APP_PUBLIC_BASE_URL=http://dbtccvmsfrontenduat
APP_CORS_ALLOWED_ORIGINS=http://dbtccvmsfrontenduat,http://172.22.10.17,http://dbtccvmsfrontenduat:8084,http://172.22.10.17:8084
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Oracle CBS lookup (in use): UAT Flexcube FCUBUAT.
# CBS: 10.41.30.114:1521 is connectivity-test only. JDBC must use 172.30.1.19:1521.
# When DBA sends username/password, put them in gitignored .env.prod.local:
#   CBS_DATASOURCE_USERNAME=...
#   CBS_DATASOURCE_PASSWORD=...
# Do not commit those two values.
CBS_DATASOURCE_URL=jdbc:oracle:thin:@(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=172.30.1.19)(PORT=1521))(CONNECT_DATA=(SERVER=DEDICATED)(SERVICE_NAME=fcubuat)))
CBS_DATASOURCE_USERNAME=
CBS_DATASOURCE_PASSWORD=
CBS_QUERY_TIMEOUT_SECONDS=8
CBS_CONNECT_TIMEOUT_MS=5000

# Recorded only. Filling INSIGHT_DATASOURCE_USERNAME/PASSWORD does not switch lookup.
# After DBA confirms RTVSCBS_CUST_PROFILE is on INSIGHT, switch the LIVE keys:
#   1. CBS_DATASOURCE_URL=<same value as INSIGHT_DATASOURCE_URL>
#   2. CBS_DATASOURCE_USERNAME / CBS_DATASOURCE_PASSWORD = the INSIGHT DBA credentials
#      (put those two in gitignored .env.prod.local)
INSIGHT_DATASOURCE_URL=jdbc:oracle:thin:@//10.41.30.114:1521/INSIGHT
INSIGHT_DATASOURCE_USERNAME=
INSIGHT_DATASOURCE_PASSWORD=

# Hybrid AD/LDAP (UAT LAN). Bind password goes in gitignored .env.prod.local:
#   LDAP_BIND_PASSWORD=...
# Service account username: CASHCOMP (OU: Dashen Bank/Dashen Head Office/Service User)
LDAP_ENABLED=true
LDAP_URL=ldaps://192.168.0.4:636
LDAP_FALLBACK_URL=ldap://192.168.0.4:389
LDAP_BIND_DN=CASHCOMP
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=DC=dashenbank,DC=local
LDAP_USER_SEARCH_BASE=
LDAP_USER_SEARCH_FILTER=(&(objectClass=user)(sAMAccountName={0}))
LDAP_DOMAIN=dashenbank.local
LDAP_SSL_PEER_NAME=ldap.dashenbank.local
LDAP_ROLE_PRIORITY=TITLE_THEN_GROUP
LDAP_TITLE_MAPPINGS=
LDAP_GROUP_MAPPINGS=
LDAP_SYNC_ENABLED=false
LDAP_SYNC_CRON=0 0 * * * *
LDAP_SYNC_DISCOVERY=false
