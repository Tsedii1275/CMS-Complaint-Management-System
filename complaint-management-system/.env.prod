# Bank internal mail hosts (UAT is on the LAN — use Local IP, not NAT).
# 192.168.0.145 (primary) / 192.168.0.146 (backup)  ports 25, 587
SPRING_MAIL_HOST=192.168.0.145
SPRING_MAIL_HOST_BACKUP=192.168.0.146
SPRING_MAIL_PORT=587
SPRING_MAIL_SMTP_AUTH=false
SPRING_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_SMTP_STARTTLS_REQUIRED=true
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Customer notifications (see application.properties for every NOTIFICATION_* key).
# Replace NOTIFICATION_EMAIL_FROM with the approved Customer Care mailbox when mail team confirms it.
# Secrets for a future SMS gateway go in gitignored .env.prod.local, not here:
#   NOTIFICATION_SMS_GATEWAY_API_KEY / NOTIFICATION_SMS_GATEWAY_PASSWORD
NOTIFICATION_ENABLED=true
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_EMAIL_PROVIDER=smtp
NOTIFICATION_EMAIL_FROM=customerservice@dashenbank.com
NOTIFICATION_EMAIL_FROM_NAME=Customer Service Team
NOTIFICATION_EMAIL_REPLY_TO=
NOTIFICATION_SMS_ENABLED=true
NOTIFICATION_SMS_PROVIDER=log
NOTIFICATION_SMS_SENDER_ID=
NOTIFICATION_SMS_DEFAULT_COUNTRY_CODE=251
NOTIFICATION_SMS_GATEWAY_BASE_URL=
NOTIFICATION_RETRY_MAX_ATTEMPTS=5

APP_PUBLIC_BASE_URL=http://dbtccvmsfrontenduat
APP_CORS_ALLOWED_ORIGINS=http://dbtccvmsfrontenduat,http://172.22.10.17,http://dbtccvmsfrontenduat:8084,http://172.22.10.17:8084
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Oracle CBS lookup (in use): UAT Flexcube FCUBUAT.
# When DBA sends username/password, put them in gitignored .env.prod.local:
#   CBS_DATASOURCE_USERNAME=...
#   CBS_DATASOURCE_PASSWORD=...
# Do not commit those two values.
CBS_DATASOURCE_URL=jdbc:oracle:thin:@//10.41.30.114:1521/fcubuat
CBS_DATASOURCE_USERNAME=
CBS_DATASOURCE_PASSWORD=
CBS_QUERY_TIMEOUT_SECONDS=8
CBS_CONNECT_TIMEOUT_MS=5000

# Recorded only. Filling INSIGHT_DATASOURCE_USERNAME/PASSWORD does not switch lookup.
# After DBA confirms RTVSCBS_CUST_PROFILE is on INSIGHT, switch the LIVE keys:
#   1. CBS_DATASOURCE_URL=<same value as INSIGHT_DATASOURCE_URL>
#   2. CBS_DATASOURCE_USERNAME / CBS_DATASOURCE_PASSWORD = the INSIGHT DBA credentials
#      (put those two in gitignored .env.prod.local)
INSIGHT_DATASOURCE_URL=jdbc:oracle:thin:@//10.41.30.114:1521/INSIGHT
INSIGHT_DATASOURCE_USERNAME=
INSIGHT_DATASOURCE_PASSWORD=
